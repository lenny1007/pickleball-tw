---
// 文章段落軌：寬螢幕（≥1200px）時固定在內文右側，列出 H2，捲到哪段就亮哪段。
// H2 以「第一步／第二步…」開頭的會顯示步驟數字；延伸閱讀、參考影片、資料來源這類附錄不列。
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[] }
const SKIP = new Set(['延伸閱讀', '參考影片', '資料來源', '這篇怎麼整理的']);
const NUM: Record<string, number> = { 一: 1, 二: 2, 三: 3, 四: 4, 五: 5, 六: 6, 七: 7, 八: 8, 九: 9 };
const items = Astro.props.headings
  .filter((h) => h.depth === 2 && !SKIP.has(h.text))
  .map((h) => {
    const m = h.text.match(/^第([一二三四五六七八九])步[：:]\s*(.+)$/);
    return { id: h.slug, title: m ? m[2] : h.text.split('：')[0], step: m ? NUM[m[1]] : undefined };
  });
---
{items.length >= 3 && (
  <nav class="rail" aria-label="本文段落">
    <ol>
      {items.map((i) => (
        <li class:list={{ stepped: i.step }}>
          <a href={`#${i.id}`} data-target={i.id}>
            <span class="dot" aria-hidden="true">{i.step ?? ''}</span>{i.title}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.rail a[data-target]')];
  const heads = links.map((a) => document.getElementById(a.dataset.target!)).filter(Boolean) as HTMLElement[];
  if (heads.length) {
    const setCurrent = () => {
      const y = window.scrollY + window.innerHeight * 0.3;
      let cur = -1;
      heads.forEach((h, i) => { if (h.offsetTop <= y) cur = i; });
      links.forEach((a, i) => (i === cur ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { setCurrent(); ticking = false; });
    }, { passive: true });
    setCurrent();
  }
</script>

<style>
  .rail { display: none; }
  @media (min-width: 1200px) {
    .rail {
      display: block; position: fixed; top: 96px; width: 220px;
      left: calc(50% - 540px + 16px + 608px + 56px);
      font-size: .9rem;
    }
    .rail ol { list-style: none; margin: 0; padding: 0 0 0 14px; border-left: 2px solid var(--rule); }
    .rail li { margin: 0; }
    .rail a { display: flex; align-items: center; gap: 10px; padding: 7px 0; color: var(--muted); text-decoration: none; line-height: 1.45; }
    .rail a:hover { color: var(--ink); }
    .rail .dot { flex: none; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-family: var(--display); font-size: .8rem; border: 2px solid var(--rule); color: var(--muted); }
    .rail li:not(.stepped) .dot { width: 10px; height: 10px; margin: 0 6px; }
    .rail a[aria-current] { color: var(--ink); }
    .rail a[aria-current] .dot { background: var(--ball); border-color: var(--ball); color: var(--ball-ink); }
  }
</style>
