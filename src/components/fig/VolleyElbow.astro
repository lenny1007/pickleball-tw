---
// 側視（右手持拍，面向左邊的網）：截擊的手臂結構。左：手肘在前、有力，球拍在腹部高度。右：手肘掉到球拍下方、手腕拱起。
import Figure from './Figure.astro';
const panels = [
  { x: 0, ok: true, t: '手肘在前、有力', s: '球拍舉在腹部高度' },
  { x: 200, ok: false, t: '手腕拱成山', s: '手肘掉到球拍下方' },
];
---
<Figure caption="側面示意圖。Coach Jess 說截擊需要有力的手肘：手肘在身體前方、球拍舉在腹部高度，迎球瞬間稍微握緊。手肘掉到球拍下方、手腕拱起來，或手肘跑到身體後面，拍面就容易打開，送出 pop-up。">
  <svg class="gear-fig vel" viewBox="0 0 400 290" role="img" aria-label="截擊手臂結構：手肘在前有力是對的；手肘掉到球拍下方、手腕拱起是錯的">
    {panels.map((p) => (
      <g transform={`translate(${p.x},0)`}>
        <rect x="10" y="10" width="180" height="200" rx="12" class="vel-card" />
        <circle cx="130" cy="52" r="15" class="vel-body" />
        <line x1="130" y1="68" x2="134" y2="160" class="vel-limb" />
        <path d="M134 160 L118 206 M134 160 L150 206" class="vel-limb" />
        {p.ok ? (
          <g>
            <path d="M130 86 L96 118 L68 104" class="vel-limb" />
            <rect x="44" y="72" width="18" height="34" rx="7" transform="rotate(-10 53 89)" class="vel-paddle" />
          </g>
        ) : (
          <g>
            <path d="M130 86 L110 140 L74 116" class="vel-limb" />
            <rect x="54" y="72" width="18" height="34" rx="7" transform="rotate(30 63 89)" class="vel-paddle" />
          </g>
        )}
        <g transform="translate(170,30)" class:list={['mk', p.ok ? 'ok' : 'fault']}>
          <circle r="11" />
          {p.ok ? <path d="M-5 0 l3.5 4 l6.5 -8" fill="none" /> : <path d="M-4.5 -4.5 l9 9 M4.5 -4.5 l-9 9" fill="none" />}
        </g>
        <text class="lab dark big" x="100" y="240" text-anchor="middle">{p.t}</text>
        <text class="lab" x="100" y="266" text-anchor="middle">{p.s}</text>
      </g>
    ))}
  </svg>
</Figure>

<style>
  .vel-card { fill: var(--paper); stroke: var(--rule); stroke-width: 2; }
  .vel-body { fill: var(--ink); }
  .vel-limb { fill: none; stroke: var(--ink); stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; }
  .vel-paddle { fill: var(--ball); stroke: var(--ink); stroke-width: 2; }
</style>
