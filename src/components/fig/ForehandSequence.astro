---
// 正手抽球的順序（右手持拍）：整體轉身 → 快快慢到球後 → 壓進右腳蓄力 → 先踏步、再揮拍。
import Figure from './Figure.astro';
const steps = [
  { n: '1', t: '整體轉身', s: '肩膀、手、球拍一起轉' },
  { n: '2', t: '快、快、慢', s: '快步到球後，右腳在球後面' },
  { n: '3', t: '蓄力', s: '壓進右腳，慢下來' },
  { n: '4', t: '踏步，再揮拍', s: '踏左腳，不要同時揮' },
];
---
<Figure caption="示意圖，以右手持拍為準。Coach Jess 教正手抽球的順序：整體轉身；用「快、快、慢」的步伐快速到球後方，再慢下來壓進右腳蓄力；接著先踏步、再揮拍。她說不要踏步和揮拍同時，也不要揮拍跑在踏步前面。">
  <svg class="gear-fig fhs" viewBox="0 0 400 392" role="img" aria-label="正手抽球四個步驟：整體轉身、快快慢到球後、壓進右腳蓄力、先踏步再揮拍">
    {steps.map((st, i) => (
      <g transform={`translate(20,${12 + i * 86})`}>
        <rect width="360" height="70" rx="14" class="fhs-card" />
        <circle cx="38" cy="35" r="18" class="fhs-num" />
        <text x="38" y="42" text-anchor="middle" class="fhs-n">{st.n}</text>
        <text class="lab dark big" x="72" y="30">{st.t}</text>
        <text class="lab" x="72" y="56">{st.s}</text>
      </g>
    ))}
    {[0, 1, 2].map((i) => <path d={`M38 ${84 + i * 86} l0 12 m-6 -6 l6 6 l6 -6`} class="fhs-arrow" />)}
    <rect x="20" y="356" width="360" height="32" rx="16" class="fhs-bar" />
    <text class="lab dark" x="200" y="378" text-anchor="middle">力量從地面往上</text>
  </svg>
</Figure>

<style>
  .fhs-card { fill: var(--paper); stroke: var(--rule); stroke-width: 2; }
  .fhs-num { fill: var(--court); }
  .fhs-n { fill: var(--on-court); font: 18px var(--display); }
  .fhs-arrow { fill: none; stroke: var(--muted); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .fhs-bar { fill: var(--kitchen); }
</style>
