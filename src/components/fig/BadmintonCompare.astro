---
// 羽球場改打匹克球：上排是離網距離（1 公尺 = 200 單位，網在 x=500），
// 下排是網高（1 公尺 = 100 單位，地面 y=400）。
import Figure from './Figure.astro';
const net = 500, g1 = 120;
const bad = net - 1.98 * 200, pb = net - 2.13 * 200;
const g2 = 430;
---
<Figure caption="示意圖，上下兩排比例不同。上排：羽球的前發球線離網 1.98 公尺，匹克球的非截擊區線離網 2.13 公尺，要往後多畫 15 公分。下排：羽球網中間高 1.524 公尺，匹克球網中間只有 86.4 公分。">
  <svg class="gear-fig bc" viewBox="0 0 540 470" role="img" aria-label="羽球場與匹克球場比較：非截擊區線比羽球前發球線離網遠 15 公分；羽球網高 1.524 公尺，匹克球網高 86.4 公分">
    <text class="lab dark big" x="20" y="34">離網距離</text>
    <rect x="20" y={g1} width={net - 20} height="12" fill="var(--court)" />
    <rect x={net - 3} y={g1 - 60} width="6" height="72" fill="var(--ink)" />
    <text class="lab big" x={net - 10} y={g1 - 68} text-anchor="end">網</text>
    <rect x={bad - 2} y={g1 - 22} width="4" height="34" fill="var(--muted)" />
    <text class="lab big" x={bad + 8} y={g1 - 30}>羽球前發球線 1.98 m</text>
    <rect x={pb - 3} y={g1} width="6" height="34" fill="var(--ball)" stroke="var(--ink)" stroke-width="1" />
    <text class="lab dark big" x={pb - 2} y={g1 + 62}>非截擊區線 2.13 m</text>
    <text class="lab dark big" x={pb - 2} y={g1 + 90}>多 15 公分</text>

    <line x1="20" y1="236" x2="520" y2="236" stroke="var(--rule)" stroke-width="1.5" />
    <text class="lab dark big" x="20" y="270">網子中間多高</text>
    <line x1="20" y1={g2} x2="520" y2={g2} stroke="var(--rule)" stroke-width="3" />
    <rect x="230" y={g2 - 152.4} width="70" height="152.4" class="bc-net" />
    <rect x="380" y={g2 - 86.4} width="70" height="86.4" class="bc-net pb" />
    <text class="lab dark big" x="265" y={g2 - 162} text-anchor="middle">羽球 1.524 m</text>
    <text class="lab dark big" x="415" y={g2 - 96} text-anchor="middle">匹克球 86.4 cm</text>
  </svg>
</Figure>

<style>
  .bc-net { fill: var(--muted); opacity: .35; }
  .bc-net.pb { fill: var(--court); opacity: 1; }
</style>
