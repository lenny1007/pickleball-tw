---
// 俯視：誰喊哪幾條線（USA Pickleball 2026 規則書）。座標同 Court：1 呎 = 10 單位。
// 上：臨打（沒有裁判），自己這半場的線（底線、兩條邊線、中線、非截擊區線）自己喊。
// 下：有司線的比賽，球員只喊自己這半場的中線，其他線交給司線。
import Court from './Court.astro';
import Figure from './Figure.astro';
import Player from './Player.astro';
const ours = [
  [0, 0, 0, 200], [0, 0, 220, 0], [0, 200, 220, 200], [0, 100, 150, 100], [150, 0, 150, 200],
];
const panels = [
  { title: '臨打（沒有裁判）', lines: ours, note: '你們這半場的線都歸你們' },
  { title: '有司線的比賽', lines: [[0, 100, 150, 100]], note: '球員只喊自己這邊的中線' },
];
---
<Figure caption="俯視示意圖。黃色粗線是你們這一隊負責喊的線。上：臨打沒有裁判時，球落在你們這半場，底線、兩條邊線、中線和非截擊區線都由你們喊，雙打兩個人都可以喊。下：有司線的比賽，你們只喊自己這邊的中線，其他線由司線判。有裁判但沒有司線時，短發球歸裁判判，球員喊自己這邊的底線、邊線和中線。">
  <div class="lo-pair">
    {panels.map((p) => (
      <Court label={`${p.title}：${p.note}`} x0={-6} x1={49} y0={-7} y1={27}>
        {p.lines.map(([a, b, c, d]) => (
          <line x1={a} y1={b} x2={c} y2={d} class="lo-mine" />
        ))}
        <text class="lab dark big" x="-50" y="-30">{p.title}</text>
        <text class="lab dark big" x="-50" y="258">{p.note}</text>
        <Player x={70} y={50} label="你" />
        <Player x={70} y={150} label="隊" />
        <Player x={370} y={50} side="them" label="對" />
        <Player x={370} y={150} side="them" label="對" />
      </Court>
    ))}
  </div>
</Figure>

<style>
  .lo-pair { display: grid; gap: 12px; }
  .lo-mine { stroke: var(--ball); stroke-width: 9; stroke-linecap: round; }
</style>
