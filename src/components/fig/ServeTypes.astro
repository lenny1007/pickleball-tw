---
// 兩種發球的側面示意（不按比例）：上排截擊式發球、下排落地發球。
import Figure from './Figure.astro';
---
<Figure caption="側面示意圖，不按比例。上排是截擊式發球：拍子由下往上揮，拍頭不高過手腕，擊球點不高過腰。下排是落地發球：球從手上自然放下，彈起來再打，上面三個條件就不用管。">
  <svg class="gear-fig st" viewBox="0 0 540 470" role="img" aria-label="兩種發球：截擊式發球由下往上揮、拍頭低於手腕、擊球點低於腰；落地發球讓球自然落下彈地後再打">
    <text class="lab dark big" x="20" y="34">截擊式發球</text>
    <line x1="20" y1="210" x2="520" y2="210" class="st-ground" />
    <line x1="60" y1="112" x2="470" y2="112" class="st-waist" />
    <text class="lab big" x="470" y="104" text-anchor="end">腰的高度</text>
    <g class="st-body">
      <line x1="140" y1="70" x2="140" y2="150" /><line x1="140" y1="150" x2="122" y2="208" /><line x1="140" y1="150" x2="164" y2="208" />
      <line x1="140" y1="88" x2="196" y2="140" />
    </g>
    <circle cx="140" cy="56" r="13" class="st-head" />
    <rect x="200" y="140" width="22" height="44" rx="9" class="st-paddle" transform="rotate(-20 211 150)" />
    <circle cx="238" cy="150" r="8" class="ball-dot" />
    <path d="M176 196 Q206 196 232 168" class="st-arrow" />
    <text class="lab dark big" x="262" y="164">由下往上</text>
    <text class="lab dark big" x="262" y="192">拍頭低於手腕</text>

    <line x1="20" y1="240" x2="520" y2="240" stroke="var(--rule)" stroke-width="1.5" />
    <text class="lab dark big" x="20" y="276">落地發球</text>
    <line x1="20" y1="440" x2="520" y2="440" class="st-ground" />
    <g class="st-body">
      <line x1="120" y1="300" x2="120" y2="380" /><line x1="120" y1="380" x2="102" y2="438" /><line x1="120" y1="380" x2="144" y2="438" />
      <line x1="120" y1="318" x2="176" y2="340" />
    </g>
    <circle cx="120" cy="286" r="13" class="st-head" />
    <circle cx="190" cy="346" r="8" class="ball-dot" />
    <path d="M190 360 L230 436 L270 392" class="st-drop" />
    <circle cx="270" cy="392" r="8" class="ball-dot" />
    <rect x="282" y="372" width="22" height="44" rx="9" class="st-paddle" transform="rotate(10 293 394)" />
    <g class="step" transform="translate(190,322)"><circle r="12" /><text y="5" text-anchor="middle" class="lab">1</text></g>
    <g class="step" transform="translate(204,424)"><circle r="12" /><text y="5" text-anchor="middle" class="lab">2</text></g>
    <g class="step" transform="translate(320,370)"><circle r="12" /><text y="5" text-anchor="middle" class="lab">3</text></g>
    <text class="lab dark big" x="342" y="318">1 放球</text>
    <text class="lab dark big" x="342" y="346">2 彈地</text>
    <text class="lab dark big" x="342" y="374">3 擊球</text>
  </svg>
</Figure>

<style>
  .st-ground { stroke: var(--rule); stroke-width: 3; }
  .st-waist { stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 6 5; }
  .st-body line { stroke: var(--ink); stroke-width: 9; stroke-linecap: round; }
  .st-head { fill: var(--ink); }
  .st-paddle { fill: var(--muted); }
  .st-arrow, .st-drop { fill: none; stroke: var(--ball); stroke-width: 3; stroke-dasharray: 7 6; }
</style>
