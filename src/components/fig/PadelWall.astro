---
// 側視：牆在兩種運動裡的角色。上：板式網球，球先落地再碰牆，落地第二次前打回去就好；
// 沒落地直接打到對方的牆是失誤。下：匹克球，球碰到圍網或牆就算失誤。
import Figure from './Figure.astro';
---
<Figure caption="側視示意圖。上：板式網球，球在你這邊先落地、再彈到牆上，只要在第二次落地前打回去就算數；打過去的球沒落地就直接碰到對方的牆，算你失分。下：匹克球，球落在你這邊、你沒接到就碰到圍網，算你失誤；打出去的球沒落地就碰到圍網，算擊球的人失誤。">
  <svg class="gear-fig pw" viewBox="0 0 560 440" role="img" aria-label="板式網球的球可以先落地再碰牆；匹克球的球落地後沒接到、碰到圍網，算接球方失誤">
    <text class="lab dark big" x="20" y="30">板式網球</text>
    <line x1="20" y1="170" x2="470" y2="170" class="pw-floor" />
    <line x1="150" y1="170" x2="150" y2="134" class="pw-net" />
    <rect x="470" y="40" width="16" height="130" class="pw-wall" />
    <path d="M40 100 Q250 -10 470 60" class="pw-path pw-bad" />
    <path d="M40 120 Q150 40 330 170" class="pw-path" />
    <path d="M330 170 L470 100" class="pw-path" />
    <path d="M470 100 Q450 104 420 120" class="pw-path" />
    <circle cx="420" cy="120" r="9" class="ball-dot" />
    <g class="mk ok" transform="translate(330,194)"><circle r="12" /><path d="M-6 0 l4.5 5 l8 -10" fill="none" /></g>
    <text class="lab dark" x="350" y="200">先落地</text>
    <text class="lab dark" x="396" y="94" text-anchor="middle">彈牆後打回去</text>
    <g class="mk fault" transform="translate(452,30)"><circle r="12" /><path d="M-5 -5 l10 10 M5 -5 l-10 10" fill="none" /></g>
    <text class="lab" x="432" y="24" text-anchor="end">沒落地直接碰牆</text>

    <text class="lab dark big" x="20" y="260">匹克球</text>
    <line x1="20" y1="400" x2="470" y2="400" class="pw-floor" />
    <line x1="150" y1="400" x2="150" y2="364" class="pw-net" />
    <line x1="478" y1="280" x2="478" y2="400" class="pw-fence" />
    <path d="M40 350 Q150 270 360 400" class="pw-path" />
    <path d="M360 400 L478 330" class="pw-path" />
    <g class="mk ok" transform="translate(360,424)"><circle r="10" /><path d="M-5 0 l4 4 l7 -9" fill="none" /></g>
    <text class="lab dark" x="378" y="430">落地</text>
    <g class="mk fault" transform="translate(452,330)"><circle r="12" /><path d="M-5 -5 l10 10 M5 -5 l-10 10" fill="none" /></g>
    <text class="lab dark" x="436" y="306" text-anchor="end">沒接到、碰到圍網：接球方失誤</text>
  </svg>
</Figure>

<style>
  .pw-floor { stroke: var(--court); stroke-width: 6; }
  .pw-net { stroke: var(--ink); stroke-width: 4; }
  .pw-wall { fill: var(--ink); }
  .pw-fence { stroke: var(--muted); stroke-width: 5; stroke-dasharray: 4 5; }
  .pw-path { fill: none; stroke: var(--ball); stroke-width: 3; stroke-dasharray: 6 5; }
  .pw-bad { stroke: var(--muted); }
</style>
