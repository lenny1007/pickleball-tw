---
// 俯視半場：在網球場上畫一面匹克球場、直接用網球網。1 公尺 = 40 單位，原點在網球網中央，x 往底線方向。
// 網球：單打邊線 y = ±4.115、雙打邊線 ±5.485、發球線 x = 6.40、中央發球線 y = 0（x 0 到 6.40）。
// 匹克球：底線 x = 6.705、邊線 y = ±3.05、非截擊區線 x = 2.13、中線 y = 0（x 2.13 到 6.705）。都量到線的外緣。
import Figure from './Figure.astro';
const s = 40;
const X = (m: number) => m * s;
---
<Figure caption="俯視示意圖，依比例畫，只畫一個半場。灰線是網球場本來的線，黃線是要自己貼或放標記的線。網球的中央發球線剛好在匹克球中線的位置；非截擊區線、兩條邊線和底線都要另外貼。">
  <svg class="gear-fig tov" viewBox={`${X(-0.6)} ${X(-6.9)} ${X(9.4)} ${X(13.6)}`} role="img" aria-label="網球場半場上的匹克球場：非截擊區線離網 2.13 公尺要自己貼，邊線在網球單打邊線往內約 1.07 公尺，底線在網球發球線後面約 30 公分，網球中央發球線可以當匹克球中線">
    <rect x={X(-0.6)} y={X(-6.9)} width={X(9.4)} height={X(13.6)} fill="var(--apron)" />
    <rect x={X(0)} y={X(-3.05)} width={X(6.705)} height={X(6.1)} class="tov-pb" />
    <rect x={X(0)} y={X(-3.05)} width={X(2.13)} height={X(6.1)} class="tov-k" />
    <g class="tov-tennis">
      <line x1="0" y1={X(-5.485)} x2={X(8.8)} y2={X(-5.485)} />
      <line x1="0" y1={X(5.485)} x2={X(8.8)} y2={X(5.485)} />
      <line x1="0" y1={X(-4.115)} x2={X(8.8)} y2={X(-4.115)} />
      <line x1="0" y1={X(4.115)} x2={X(8.8)} y2={X(4.115)} />
      <line x1={X(6.4)} y1={X(-4.115)} x2={X(6.4)} y2={X(4.115)} />
    </g>
    <line x1={X(2.13)} y1="0" x2={X(6.4)} y2="0" class="tov-reuse" />
    <g class="tov-tape">
      <line x1={X(2.13)} y1={X(-3.05)} x2={X(2.13)} y2={X(3.05)} />
      <line x1="0" y1={X(-3.05)} x2={X(6.705)} y2={X(-3.05)} />
      <line x1="0" y1={X(3.05)} x2={X(6.705)} y2={X(3.05)} />
      <line x1={X(6.705)} y1={X(-3.05)} x2={X(6.705)} y2={X(3.05)} />
      <line x1={X(6.4)} y1="0" x2={X(6.705)} y2="0" />
    </g>
    <line x1="0" y1={X(-6.4)} x2="0" y2={X(6.4)} stroke="var(--ink)" stroke-width="7" stroke-linecap="round" />
    <text class="lab dark big" x={X(0.2)} y={X(-6.15)}>網球網</text>
    <text class="lab big tov-on" x={X(1.06)} y={X(-1.4)} text-anchor="middle">非截擊區</text>
    <text class="lab dark" x={X(2.13)} y={X(-3.35)} text-anchor="middle">離網 2.13 m</text>
    <text class="lab dark" x={X(6.55)} y={X(-4.45)} text-anchor="middle">發球線 6.40 m</text>
    <text class="lab dark" x={X(6.705)} y={X(3.75)} text-anchor="middle">底線 6.71 m</text>
    <text class="lab tov-on" x={X(4.3)} y={X(-0.25)} text-anchor="middle">沿用中央發球線</text>
    <line x1={X(2.6)} y1={X(3.05)} x2={X(2.6)} y2={X(4.115)} class="tov-dim" />
    <text class="lab dark" x={X(4.3)} y={X(4.9)} text-anchor="middle">單打邊線往內 1.07 m</text>
    <text class="lab" x={X(4.3)} y={X(6.3)} text-anchor="middle">網球雙打邊線</text>
  </svg>
</Figure>

<style>
  .tov-pb { fill: var(--court); }
  .tov-k { fill: var(--kitchen); }
  .tov-tennis { stroke: var(--muted); stroke-width: 4; }
  .tov-reuse { stroke: var(--line); stroke-width: 5; }
  .tov-dim { stroke: var(--ink); stroke-width: 3; stroke-dasharray: 4 3; }
  .tov-tape { stroke: var(--ball); stroke-width: 6; stroke-linecap: round; }
  .tov .tov-on { fill: var(--on-court); }
</style>
