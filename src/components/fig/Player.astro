---
// 球員記號：us＝深色實心，them＝空心。x、y 用球場座標（單位）。
interface Props { x: number; y: number; side?: 'us' | 'them'; label?: string; mark?: 'ok' | 'fault' }
const { x, y, side = 'us', label, mark } = Astro.props;
---
<g class:list={['pl', side]}>
  <circle cx={x} cy={y} r="11" />
  {label && <text x={x} y={y + 5} text-anchor="middle" class="pl-label">{label}</text>}
  {mark === 'ok' && (
    <g transform={`translate(${x + 13},${y - 22})`} class="mk ok">
      <circle r="10" /><path d="M-5 0 l3.5 4 l6.5 -8" fill="none" />
    </g>
  )}
  {mark === 'fault' && (
    <g transform={`translate(${x + 13},${y - 22})`} class="mk fault">
      <circle r="10" /><path d="M-4.5 -4.5 l9 9 M4.5 -4.5 l-9 9" fill="none" />
    </g>
  )}
</g>
