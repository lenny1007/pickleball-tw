---
import Figure from './Figure.astro';
// 示意圖：臨打排球拍。先到先排，一場打完，最前面四支上場。
const slots = Array.from({ length: 7 }, (_, i) => i);
---
<Figure caption="臨打常見的排球拍：想打的人把自己的球拍放進架上排隊，一場打完，排在最前面的四支球拍上場。">
  <svg class="gear-fig" viewBox="0 0 480 230" role="img" aria-label="球拍架排隊示意：最前面四支球拍下一場上場">
    <rect x="20" y="150" width="300" height="14" rx="7" class="rack" />
    {slots.map((i) => {
      const x = 290 - i * 40;
      const next = i < 4;
      return (
        <g>
          <rect x={x - 15} y="62" width="30" height="62" rx="11" class:list={['rack-paddle', { next }]} />
          <rect x={x - 5} y="122" width="10" height="34" rx="4" class:list={['rack-grip', { next }]} />
        </g>
      );
    })}
    <path d="M156 44 h148" class="bracket" /><path d="M156 38 v12 M304 38 v12" class="bracket" />
    <text x="230" y="30" text-anchor="middle" class="lab dark">下一場上場</text>
    <text x="90" y="30" text-anchor="middle" class="lab muted">之後</text>
    <g transform="translate(360,58)">
      <rect width="96" height="110" rx="6" fill="var(--court)" />
      <rect y="40" width="96" height="30" fill="var(--kitchen)" />
      <g stroke="var(--line)" stroke-width="2" fill="none"><rect width="96" height="110" rx="6" /><line y1="55" x2="96" y2="55" stroke="var(--ink)" stroke-width="3" /></g>
      <text x="48" y="140" text-anchor="middle" class="lab dark">空出來的場</text>
    </g>
    <path d="M316 112 C 328 112, 336 112, 350 112" class="arrow-line" />
    <path d="M342 106 l9 6 l-9 6" class="arrow-line" />
    <text x="20" y="200" class="lab muted">先到先排，每個人放自己的球拍；越靠右越先上場</text>
  </svg>
</Figure>
