---
// 熱身三步：先讓心跳上來 → 動態伸展各關節 → 把比賽會打的球都熱過。內容依 Better Pickleball 的 CJ Johnson。
import Figure from './Figure.astro';
const steps = [
  { n: '1', t: '讓心跳上來', s: '快走、慢跑、側併步，到有點喘' },
  { n: '2', t: '動態伸展', s: '從肩膀到腳踝，畫圈或擺動' },
  { n: '3', t: '每一種球都熱過', s: 'dink、截擊、drop、底線、發球' },
];
---
<Figure caption="示意圖。Better Pickleball 的教練 CJ Johnson 建議的熱身順序：先讓心跳上來，再用動態伸展把各關節動開，最後把比賽會打的球都打過一輪。伸展要在身體暖起來之後做，不應該痛。">
  <svg class="gear-fig wus" viewBox="0 0 400 306" role="img" aria-label="熱身三步：讓心跳上來、動態伸展、每一種球都熱過">
    {steps.map((st, i) => (
      <g transform={`translate(20,${12 + i * 86})`}>
        <rect width="360" height="70" rx="14" class="wus-card" />
        <circle cx="38" cy="35" r="18" class="wus-num" />
        <text x="38" y="42" text-anchor="middle" class="wus-n">{st.n}</text>
        <text class="lab dark big" x="72" y="30">{st.t}</text>
        <text class="lab" x="72" y="56">{st.s}</text>
      </g>
    ))}
    {[0, 1].map((i) => <path d={`M38 ${84 + i * 86} l0 12 m-6 -6 l6 6 l6 -6`} class="wus-arrow" />)}
    <rect x="20" y="270" width="360" height="32" rx="16" class="wus-bar" />
    <text class="lab dark" x="200" y="292" text-anchor="middle">先暖身體，再拉開關節，最後才打球</text>
  </svg>
</Figure>

<style>
  .wus-card { fill: var(--paper); stroke: var(--rule); stroke-width: 2; }
  .wus-num { fill: var(--court); }
  .wus-n { fill: var(--on-court); font: 18px var(--display); }
  .wus-arrow { fill: none; stroke: var(--muted); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .wus-bar { fill: var(--kitchen); }
</style>
