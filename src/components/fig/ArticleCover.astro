      <path d="M250 78 Q206 78 210 112 Q216 140 254 144 M390 78 Q434 78 430 112 Q424 140 386 144" fill="none" stroke="var(--ink)" stroke-width="5" stroke-linecap="round" />
      <rect x="304" y="176" width="32" height="24" fill="var(--ink)" />
      <rect x="270" y="198" width="100" height="22" rx="4" fill="var(--ink)" />
      <g fill="var(--card)" stroke="var(--ink)" stroke-width="4"><rect x="70" y="120" width="120" height="96" rx="10" /><rect x="450" y="120" width="120" height="96" rx="10" /></g>
      <g stroke="var(--muted)" stroke-width="7" stroke-linecap="round"><line x1="94" y1="150" x2="166" y2="150" /><line x1="94" y1="180" x2="150" y2="180" /><line x1="474" y1="150" x2="546" y2="150" /><line x1="474" y1="180" x2="530" y2="180" /></g>
    </g>
