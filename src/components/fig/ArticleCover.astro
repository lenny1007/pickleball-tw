---
// 文章封面：同一套球場俯視語言，每篇裁一個跟主題有關的畫面。純 SVG，跟著深淺色 token 變色。
interface Props { slug: string; small?: boolean }
const { slug, small = false } = Astro.props;
const kind =
  slug.includes('open-play') ? 'openplay'
  : slug.includes('tennis-court') ? 'tennis'
  : slug.includes('skill-levels') ? 'levels'
  : slug.includes('referee') ? 'ref'
  : slug.includes('faults') ? 'faults'
  : slug.includes('line-calls') ? 'linecall'
  : slug.includes('for-kids') ? 'kids'
  : slug.includes('calories') ? 'cal'
  : slug.includes('tournaments') ? 'tour'
  : slug.includes('-balls') ? 'balls'
  : slug.includes('injuries') ? 'injury'
  : slug.includes('return-of-serve') ? 'return'
  : slug.includes('warm-up') ? 'warmup'
  : slug.includes('singles') ? 'singles'
  : slug.includes('forehand') ? 'forehand'
  : slug.includes('third-shot') ? 'third'
  : slug.includes('dink') ? 'dink'
  : slug.includes('hold-paddle') ? 'hold'
  : slug.includes('pickleball-volley') ? 'volley'
  : slug.includes('backhand') ? 'backhand'
  : slug.includes('doubles') ? 'doubles'
  : slug.includes('vs-padel') ? 'padel'
  : slug.includes('practice-equipment') ? 'solo'
  : slug.includes('practice') ? 'practice'
  : slug.includes('shoes') ? 'shoes'
  : slug.includes('mistakes') ? 'mistakes'
  : slug.includes('scoring') ? 'scoring'
  : slug.includes('non-volley') ? 'nvz'
  : slug.includes('where-to-buy') ? 'buy'
  : slug.includes('paddle-recommendations') ? 'picks'
  : slug.includes('paddle-brands') ? 'brands'
  : slug.includes('paddle-grip') ? 'grip'
  : slug.includes('paddle-rules') ? 'prules'
  : slug.includes('paddle') ? 'paddle'
  : slug.includes('what-is') ? 'whatis'
  : slug.includes('first-time') ? 'first'
  : slug.includes('where-to-play') ? 'venues'
  : slug.includes('vs-tennis') ? 'vs'
  : slug.includes('how-to-play') ? 'play'
  : slug.includes('serve') ? 'serve'
  : slug.includes('court-size') ? 'size'
  : slug.includes('rules-2026') ? 'r2026'
  : slug.includes('rules') ? 'rules'
  : 'corner';
---
<svg class:list={['cover', { small }]} viewBox="0 0 640 280" aria-hidden="true" focusable="false">
  <rect width="640" height="280" fill="var(--apron)" />
  {kind === 'openplay' && (
    <g>
      <rect x="380" y="12" width="170" height="256" fill="var(--court)" />
      <rect x="380" y="99" width="170" height="82" fill="var(--kitchen)" />
      <g stroke="var(--line)" stroke-width="4" fill="none">
        <rect x="380" y="12" width="170" height="256" />
        <line x1="380" y1="99" x2="550" y2="99" /><line x1="380" y1="181" x2="550" y2="181" />
        <line x1="465" y1="12" x2="465" y2="99" /><line x1="465" y1="181" x2="465" y2="268" />
      </g>
      <line x1="368" y1="140" x2="562" y2="140" stroke="var(--ink)" stroke-width="7" stroke-linecap="round" />
      <rect x="40" y="196" width="250" height="16" rx="8" fill="var(--ink)" />
      {[0, 1, 2, 3, 4].map((i) => (
        <g transform={`translate(${250 - i * 46},92)`}>
          <rect x="-17" y="0" width="34" height="72" rx="13" fill={i < 4 ? 'var(--ball)' : 'var(--card)'} stroke="var(--ink)" stroke-width="4" />
          <rect x="-5" y="70" width="10" height="34" rx="4" fill="var(--ink)" />
        </g>
      ))}
      <path d="M300 128 h48 m-12 -12 l12 12 l-12 12" fill="none" stroke="var(--ink)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="510" cy="226" r="14" class="ball-dot" />
    </g>
  )}
  {kind === 'tennis' && (
    <g>
      <rect x="20" y="40" width="600" height="220" fill="var(--court)" opacity=".35" />
      <g stroke="var(--line)" stroke-width="3" fill="none" opacity=".7">
        <rect x="20" y="40" width="600" height="220" />
        <line x1="20" y1="72" x2="620" y2="72" /><line x1="20" y1="228" x2="620" y2="228" />
        <line x1="158" y1="72" x2="158" y2="228" /><line x1="482" y1="72" x2="482" y2="228" />
        <line x1="158" y1="150" x2="482" y2="150" />
      </g>
      <rect x="148" y="92" width="344" height="116" fill="var(--court)" />
      <rect x="265" y="92" width="110" height="116" fill="var(--kitchen)" />
      <g stroke="var(--ball)" stroke-width="5" fill="none" stroke-linecap="round">
        <rect x="148" y="92" width="344" height="116" />
        <line x1="265" y1="92" x2="265" y2="208" /><line x1="375" y1="92" x2="375" y2="208" />
      </g>
      <line x1="320" y1="26" x2="320" y2="274" stroke="var(--ink)" stroke-width="7" stroke-linecap="round" />
      <circle cx="550" cy="248" r="14" class="ball-dot" />
    </g>
  )}
  {kind === 'levels' && (
    <g>
      <rect x="0" y="222" width="640" height="58" fill="var(--court)" />
      <line x1="0" y1="222" x2="640" y2="222" stroke="var(--line)" stroke-width="5" />
      <g stroke="var(--ink)" stroke-width="5" stroke-linejoin="round">
        <rect x="90" y="172" width="90" height="50" rx="6" fill="var(--card)" />
        <rect x="200" y="142" width="90" height="80" rx="6" fill="var(--kitchen)" />
        <rect x="310" y="106" width="90" height="116" rx="6" fill="var(--court)" fill-opacity=".55" />
        <rect x="420" y="66" width="90" height="156" rx="6" fill="var(--court)" />
