  )}
  {kind === 'kids' && (
    <g>
      <rect x="40" y="150" width="560" height="110" fill="var(--court)" />
      <rect x="250" y="150" width="140" height="110" fill="var(--kitchen)" />
      <rect x="40" y="150" width="105" height="110" fill="var(--paper)" opacity=".5" />
      <rect x="495" y="150" width="105" height="110" fill="var(--paper)" opacity=".5" />
      <line x1="145" y1="144" x2="145" y2="266" stroke="var(--ball)" stroke-width="8" stroke-linecap="round" />
