      <rect x="330" y="40" width="230" height="170" rx="14" fill="var(--card)" stroke="var(--ink)" stroke-width="5" />
      <g stroke="var(--muted)" stroke-width="8" stroke-linecap="round"><line x1="410" y1="84" x2="530" y2="84" /><line x1="410" y1="126" x2="530" y2="126" /><line x1="410" y1="168" x2="510" y2="168" /></g>
