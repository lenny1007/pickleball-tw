      <path d="M110 150 Q250 60 430 40" fill="none" stroke="var(--muted)" stroke-width="5" stroke-dasharray="10 8" stroke-linecap="round" />
    </g>
  )}
  {kind === 'cal' && (
    <g>
      <rect x="0" y="222" width="640" height="58" fill="var(--court)" />
      <line x1="0" y1="222" x2="640" y2="222" stroke="var(--line)" stroke-width="5" />
