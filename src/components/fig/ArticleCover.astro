---
// 文章封面：同一套球場俯視語言，每篇裁一個跟主題有關的畫面。純 SVG，跟著深淺色 token 變色。
interface Props { slug: string; small?: boolean }
const { slug, small = false } = Astro.props;
const kind =
  slug.includes('non-volley') ? 'nvz'
  : slug.includes('paddle') ? 'paddle'
  : slug.includes('first-time') ? 'first'
  : slug.includes('where-to-play') ? 'venues'
  : slug.includes('rules') ? 'rules'
  : 'corner';
---
<svg class:list={['cover', { small }]} viewBox="0 0 640 280" aria-hidden="true" focusable="false">
  <rect width="640" height="280" fill="var(--apron)" />
  {kind === 'rules' && (
    <g transform="translate(100,40)">
      <rect width="440" height="200" fill="var(--court)" />
      <rect x="150" width="140" height="200" fill="var(--kitchen)" />
      <g stroke="var(--line)" stroke-width="3" fill="none">
        <rect width="440" height="200" /><line x1="150" x2="150" y2="200" /><line x1="290" x2="290" y2="200" />
        <line y1="100" x2="150" y2="100" /><line x1="290" y1="100" x2="440" y2="100" />
      </g>
      <line x1="220" y1="-14" x2="220" y2="214" stroke="var(--ink)" stroke-width="6" stroke-linecap="round" />
      <path d="M-10 160 Q170 40 370 50" class="cv-trail" />
      <path d="M420 44 Q260 230 80 150" class="cv-trail" />
      <g class="bounce"><circle cx="370" cy="50" r="9" /><circle cx="80" cy="150" r="9" /></g>
      <circle cx="80" cy="150" r="9" class="ball-dot" />
    </g>
  )}
  {kind === 'nvz' && (
    <g>
      <rect x="0" y="30" width="640" height="220" fill="var(--court)" />
      <rect x="250" y="30" width="390" height="220" fill="var(--kitchen)" />
      <line x1="250" y1="30" x2="250" y2="250" stroke="var(--ball)" stroke-width="10" />
      <line x1="0" y1="30" x2="640" y2="30" stroke="var(--line)" stroke-width="4" />
      <line x1="0" y1="250" x2="640" y2="250" stroke="var(--line)" stroke-width="4" />
      <line x1="600" y1="14" x2="600" y2="266" stroke="var(--ink)" stroke-width="8" stroke-linecap="round" />
      <g class="pl us"><circle cx="210" cy="140" r="22" /></g>
      <ellipse cx="248" cy="104" rx="16" ry="20" class="cv-paddle" transform="rotate(20 248 104)" />
      <circle cx="292" cy="78" r="11" class="ball-dot" />
    </g>
  )}
  {kind === 'paddle' && (
    <g>
      <rect x="0" y="0" width="300" height="280" fill="var(--court)" />
      <line x1="300" y1="0" x2="300" y2="280" stroke="var(--line)" stroke-width="4" />
      {[{ x: 200, r: -24, w: 96, h: 120 }, { x: 330, r: 8, w: 88, h: 132 }, { x: 460, r: 30, w: 76, h: 148 }].map((p) => (
        <g transform={`rotate(${p.r} ${p.x} 150)`}>
          <rect x={p.x - p.w / 2} y={150 - p.h / 2 - 30} width={p.w} height={p.h} rx="24" class="paddle-face" />
          <rect x={p.x - 12} y={150 + p.h / 2 - 34} width="24" height="62" rx="7" class="paddle-grip" />
        </g>
      ))}
      <circle cx="560" cy="226" r="16" class="ball-dot" />
    </g>
  )}
  {kind === 'first' && (
    <g>
      <rect x="120" y="70" width="520" height="210" fill="var(--court)" />
      <line x1="120" y1="70" x2="640" y2="70" stroke="var(--line)" stroke-width="5" />
      <line x1="120" y1="70" x2="120" y2="280" stroke="var(--line)" stroke-width="5" />
      <line x1="380" y1="70" x2="380" y2="280" stroke="var(--line)" stroke-width="5" />
      <g transform="rotate(-32 300 170)">
        <rect x="250" y="80" width="100" height="124" rx="26" class="paddle-face" />
        <rect x="288" y="198" width="24" height="64" rx="7" class="paddle-grip" />
      </g>
      <circle cx="430" cy="196" r="20" class="ball-dot" />
    </g>
  )}
  {kind === 'venues' && (
    <g>
      {[0, 1, 2].flatMap((c) => [0, 1].map((r) => {
        const x = 40 + c * 196, y = 24 + r * 124;
        const lit = c === 1 && r === 0;
        return (
          <g transform={`translate(${x},${y})`}>
            <rect width="172" height="108" rx="4" fill={lit ? 'var(--court)' : 'var(--kitchen)'} opacity={lit ? 1 : 0.55} />
            <rect x="65" width="42" height="108" fill="var(--kitchen)" opacity={lit ? 1 : 0} />
            <g stroke="var(--line)" stroke-width="2.5" fill="none" opacity={lit ? 1 : 0.6}>
              <rect width="172" height="108" rx="4" /><line x1="65" x2="65" y2="108" /><line x1="107" x2="107" y2="108" />
            </g>
            <line x1="86" y1="-6" x2="86" y2="114" stroke="var(--ink)" stroke-width="4" opacity={lit ? 1 : 0.5} />
            {lit && <circle cx="130" cy="40" r="10" class="ball-dot" />}
          </g>
        );
      }))}
    </g>
  )}
  {kind === 'corner' && (
    <g>
      <rect x="80" y="60" width="560" height="220" fill="var(--court)" />
      <g stroke="var(--line)" stroke-width="5" fill="none"><line x1="80" y1="60" x2="640" y2="60" /><line x1="80" y1="60" x2="80" y2="280" /></g>
      <circle cx="320" cy="170" r="20" class="ball-dot" />
    </g>
  )}
</svg>
