---
// 文章封面：同一套球場俯視語言，每篇裁一個跟主題有關的畫面。純 SVG，跟著深淺色 token 變色。
interface Props { slug: string; small?: boolean }
const { slug, small = false } = Astro.props;
const kind =
  slug.includes('vs-padel') ? 'padel'
  : slug.includes('practice') ? 'practice'
  : slug.includes('mistakes') ? 'mistakes'
  : slug.includes('scoring') ? 'scoring'
  : slug.includes('non-volley') ? 'nvz'
  : slug.includes('paddle-grip') ? 'grip'
  : slug.includes('paddle') ? 'paddle'
  : slug.includes('what-is') ? 'whatis'
  : slug.includes('first-time') ? 'first'
  : slug.includes('where-to-play') ? 'venues'
  : slug.includes('vs-tennis') ? 'vs'
  : slug.includes('how-to-play') ? 'play'
  : slug.includes('serve') ? 'serve'
  : slug.includes('court-size') ? 'size'
  : slug.includes('rules-2026') ? 'r2026'
  : slug.includes('rules') ? 'rules'
  : 'corner';
---
<svg class:list={['cover', { small }]} viewBox="0 0 640 280" aria-hidden="true" focusable="false">
  <rect width="640" height="280" fill="var(--apron)" />
  {kind === 'practice' && (
    <g>
      <rect x="0" y="170" width="640" height="110" fill="var(--court)" />
      <rect x="0" y="170" width="180" height="110" fill="var(--kitchen)" />
      <line x1="120" y1="170" x2="120" y2="110" stroke="var(--ink)" stroke-width="6" stroke-linecap="round" />
      <g fill="none" stroke="var(--ball)" stroke-width="5" stroke-dasharray="10 8" stroke-linecap="round">
        <path d="M250 150 Q170 60 70 200" /><path d="M390 150 Q240 20 70 200" /><path d="M530 150 Q300 -20 70 200" />
      </g>
      {[250, 390, 530].map((x, i) => (<g><circle cx={x} cy="150" r="22" fill="var(--ink)" /><text x={x} y="158" text-anchor="middle" class="cv-step" fill="var(--paper)">{i + 1}</text></g>))}
      <circle cx="70" cy="200" r="14" class="ball-dot" />
    </g>
  )}
  {kind === 'padel' && (
    <g>
      <rect x="100" y="30" width="440" height="220" fill="var(--court)" />
      <rect x="194" y="77" width="252" height="126" fill="var(--kitchen)" opacity=".55" />
      <rect x="100" y="30" width="440" height="220" fill="none" stroke="var(--ink)" stroke-width="12" />
      <line x1="320" y1="18" x2="320" y2="262" stroke="var(--line)" stroke-width="5" stroke-linecap="round" />
      <path d="M220 200 L520 120 L430 70" fill="none" stroke="var(--ball)" stroke-width="5" stroke-dasharray="10 8" stroke-linecap="round" />
      <circle cx="430" cy="70" r="16" class="ball-dot" />
    </g>
  )}
  {kind === 'grip' && (
    <g>
      <rect x="0" y="0" width="640" height="280" fill="var(--court)" />
      <g transform="rotate(-20 320 140)">
        <rect x="230" y="-40" width="180" height="200" rx="44" class="paddle-face" />
        <rect x="290" y="150" width="60" height="150" rx="14" class="paddle-grip" />
        <g stroke="var(--ball)" stroke-width="6" stroke-linecap="round">
          <line x1="290" y1="182" x2="350" y2="170" /><line x1="290" y1="212" x2="350" y2="200" />
          <line x1="290" y1="242" x2="350" y2="230" /><line x1="290" y1="272" x2="350" y2="260" />
        </g>
      </g>
      <circle cx="540" cy="70" r="24" class="ball-dot" />
    </g>
  )}
  {kind === 'r2026' && (
    <g>
      <rect x="150" y="34" width="340" height="230" rx="10" fill="var(--court)" />
      <g stroke="var(--line)" stroke-width="5" stroke-linecap="round">
        <line x1="196" y1="88" x2="400" y2="88" /><line x1="196" y1="140" x2="440" y2="140" /><line x1="196" y1="192" x2="360" y2="192" />
      </g>
      <g stroke="var(--ball)" stroke-width="8" stroke-linecap="round" fill="none">
        <path d="M420 182 l14 14 l28 -34" />
      </g>
      <circle cx="500" cy="60" r="26" class="ball-dot" />
    </g>
  )}
  {kind === 'whatis' && (
    <g>
      <rect x="0" y="150" width="640" height="130" fill="var(--court)" />
      <g stroke="var(--line)" stroke-width="3" opacity=".5">
        <line x1="40" y1="190" x2="220" y2="190" /><line x1="300" y1="236" x2="520" y2="236" /><line x1="430" y1="176" x2="600" y2="176" />
      </g>
      <path d="M90 150 Q320 172 560 150 Q320 160 90 150 Z" fill="var(--ink)" />
      <g stroke="var(--ink)" stroke-width="4" stroke-linecap="round">
        <line x1="200" y1="128" x2="170" y2="196" /><line x1="290" y1="128" x2="260" y2="196" />
        <line x1="380" y1="128" x2="350" y2="196" /><line x1="470" y1="128" x2="440" y2="196" />
      </g>
      <circle cx="520" cy="70" r="34" class="ball-dot" />
    </g>
  )}
  {kind === 'vs' && (
    <g>
      <rect x="40" y="20" width="560" height="240" fill="var(--apron)" stroke="var(--line)" stroke-width="3" />
      <rect x="160" y="78" width="320" height="124" fill="var(--court)" />
      <rect x="250" y="78" width="140" height="124" fill="var(--kitchen)" />
      <rect x="160" y="78" width="320" height="124" fill="none" stroke="var(--line)" stroke-width="3" />
      <line x1="320" y1="8" x2="320" y2="272" stroke="var(--ink)" stroke-width="6" stroke-linecap="round" />
      <circle cx="420" cy="140" r="14" class="ball-dot" />
    </g>
  )}
  {kind === 'play' && (
    <g transform="translate(100,40)">
      <rect width="440" height="200" fill="var(--court)" />
      <rect x="150" width="140" height="200" fill="var(--kitchen)" />
      <g stroke="var(--line)" stroke-width="3" fill="none">
        <rect width="440" height="200" /><line x1="150" x2="150" y2="200" /><line x1="290" x2="290" y2="200" />
        <line y1="100" x2="150" y2="100" /><line x1="290" y1="100" x2="440" y2="100" />
      </g>
      <line x1="220" y1="-14" x2="220" y2="214" stroke="var(--ink)" stroke-width="6" stroke-linecap="round" />
      <path d="M-10 160 Q170 -10 370 50" class="cv-trail" />
      <path d="M440 50 Q260 -20 60 150" class="cv-trail" />
      <path d="M60 150 Q160 60 262 76" class="cv-trail" />
      <g class="bounce"><circle cx="370" cy="50" r="9" /><circle cx="60" cy="150" r="9" /></g>
      <circle cx="262" cy="76" r="10" class="ball-dot" />
      {[['1', 300, 20], ['2', 150, 30], ['3', 170, 104]].map(([n, x, y]) => (
        <g transform={`translate(${x},${y})`}><circle r="16" fill="var(--ball)" /><text y="7" text-anchor="middle" class="cv-step" fill="var(--ball-ink)">{n}</text></g>
      ))}
    </g>
  )}
  {kind === 'serve' && (
    <g>
      <rect x="0" y="40" width="640" height="200" fill="var(--court)" />
      <rect x="250" y="40" width="140" height="200" fill="var(--kitchen)" />
      <g stroke="var(--line)" stroke-width="3" fill="none">
        <line x1="0" y1="40" x2="640" y2="40" /><line x1="0" y1="240" x2="640" y2="240" />
        <line x1="250" y1="40" x2="250" y2="240" /><line x1="390" y1="40" x2="390" y2="240" />
        <line x1="0" y1="140" x2="250" y2="140" /><line x1="390" y1="140" x2="640" y2="140" />
      </g>
      <line x1="320" y1="26" x2="320" y2="254" stroke="var(--ink)" stroke-width="6" stroke-linecap="round" />
      <rect x="392" y="42" width="246" height="96" fill="var(--ball)" opacity=".25" />
      <path d="M40 200 Q300 0 520 90" class="cv-trail" />
      <g class="bounce"><circle cx="520" cy="90" r="9" /></g>
      <circle cx="40" cy="200" r="12" class="ball-dot" />
    </g>
  )}
  {kind === 'size' && (
    <g transform="translate(100,52)">
      <rect width="440" height="200" fill="var(--court)" />
      <rect x="150" width="140" height="200" fill="var(--kitchen)" />
      <g stroke="var(--line)" stroke-width="3" fill="none">
        <rect width="440" height="200" /><line x1="150" x2="150" y2="200" /><line x1="290" x2="290" y2="200" />
        <line y1="100" x2="150" y2="100" /><line x1="290" y1="100" x2="440" y2="100" />
      </g>
      <line x1="220" y1="-14" x2="220" y2="214" stroke="var(--ink)" stroke-width="6" stroke-linecap="round" />
      <g stroke="var(--ball)" stroke-width="4" stroke-linecap="round">
        <line x1="0" y1="-30" x2="440" y2="-30" /><line x1="0" y1="-40" x2="0" y2="-20" /><line x1="440" y1="-40" x2="440" y2="-20" />
        <line x1="-34" y1="0" x2="-34" y2="200" /><line x1="-44" y1="0" x2="-24" y2="0" /><line x1="-44" y1="200" x2="-24" y2="200" />
        <line x1="150" y1="224" x2="220" y2="224" /><line x1="150" y1="216" x2="150" y2="232" /><line x1="220" y1="216" x2="220" y2="232" />
      </g>
    </g>
  )}
  {kind === 'rules' && (
    <g transform="translate(100,40)">
      <rect width="440" height="200" fill="var(--court)" />
      <rect x="150" width="140" height="200" fill="var(--kitchen)" />
      <g stroke="var(--line)" stroke-width="3" fill="none">
        <rect width="440" height="200" /><line x1="150" x2="150" y2="200" /><line x1="290" x2="290" y2="200" />
        <line y1="100" x2="150" y2="100" /><line x1="290" y1="100" x2="440" y2="100" />
      </g>
      <line x1="220" y1="-14" x2="220" y2="214" stroke="var(--ink)" stroke-width="6" stroke-linecap="round" />
      <path d="M-10 160 Q170 40 370 50" class="cv-trail" />
      <path d="M420 44 Q260 230 80 150" class="cv-trail" />
      <g class="bounce"><circle cx="370" cy="50" r="9" /><circle cx="80" cy="150" r="9" /></g>
      <circle cx="80" cy="150" r="9" class="ball-dot" />
    </g>
  )}
  {kind === 'nvz' && (
    <g>
      <rect x="0" y="30" width="640" height="220" fill="var(--court)" />
      <rect x="250" y="30" width="390" height="220" fill="var(--kitchen)" />
      <line x1="250" y1="30" x2="250" y2="250" stroke="var(--ball)" stroke-width="10" />
      <line x1="0" y1="30" x2="640" y2="30" stroke="var(--line)" stroke-width="4" />
      <line x1="0" y1="250" x2="640" y2="250" stroke="var(--line)" stroke-width="4" />
      <line x1="600" y1="14" x2="600" y2="266" stroke="var(--ink)" stroke-width="8" stroke-linecap="round" />
      <g class="pl us"><circle cx="210" cy="140" r="22" /></g>
      <ellipse cx="248" cy="104" rx="16" ry="20" class="cv-paddle" transform="rotate(20 248 104)" />
      <circle cx="292" cy="78" r="11" class="ball-dot" />
    </g>
  )}
  {kind === 'paddle' && (
    <g>
      <rect x="0" y="0" width="300" height="280" fill="var(--court)" />
      <line x1="300" y1="0" x2="300" y2="280" stroke="var(--line)" stroke-width="4" />
      {[{ x: 200, r: -24, w: 96, h: 120 }, { x: 330, r: 8, w: 88, h: 132 }, { x: 460, r: 30, w: 76, h: 148 }].map((p) => (
        <g transform={`rotate(${p.r} ${p.x} 150)`}>
          <rect x={p.x - p.w / 2} y={150 - p.h / 2 - 30} width={p.w} height={p.h} rx="24" class="paddle-face" />
          <rect x={p.x - 12} y={150 + p.h / 2 - 34} width="24" height="62" rx="7" class="paddle-grip" />
        </g>
      ))}
      <circle cx="560" cy="226" r="16" class="ball-dot" />
    </g>
  )}
  {kind === 'first' && (
    <g>
      <rect x="120" y="70" width="520" height="210" fill="var(--court)" />
      <line x1="120" y1="70" x2="640" y2="70" stroke="var(--line)" stroke-width="5" />
      <line x1="120" y1="70" x2="120" y2="280" stroke="var(--line)" stroke-width="5" />
      <line x1="380" y1="70" x2="380" y2="280" stroke="var(--line)" stroke-width="5" />
      <g transform="rotate(-32 300 170)">
        <rect x="250" y="80" width="100" height="124" rx="26" class="paddle-face" />
        <rect x="288" y="198" width="24" height="64" rx="7" class="paddle-grip" />
      </g>
      <circle cx="430" cy="196" r="20" class="ball-dot" />
    </g>
  )}
  {kind === 'venues' && (
    <g>
      {[0, 1, 2].flatMap((c) => [0, 1].map((r) => {
        const x = 40 + c * 196, y = 24 + r * 124;
        const lit = c === 1 && r === 0;
        return (
          <g transform={`translate(${x},${y})`}>
            <rect width="172" height="108" rx="4" fill={lit ? 'var(--court)' : 'var(--kitchen)'} opacity={lit ? 1 : 0.55} />
            <rect x="65" width="42" height="108" fill="var(--kitchen)" opacity={lit ? 1 : 0} />
            <g stroke="var(--line)" stroke-width="2.5" fill="none" opacity={lit ? 1 : 0.6}>
              <rect width="172" height="108" rx="4" /><line x1="65" x2="65" y2="108" /><line x1="107" x2="107" y2="108" />
            </g>
            <line x1="86" y1="-6" x2="86" y2="114" stroke="var(--ink)" stroke-width="4" opacity={lit ? 1 : 0.5} />
            {lit && <circle cx="130" cy="40" r="10" class="ball-dot" />}
          </g>
        );
      }))}
    </g>
  )}
  {kind === 'mistakes' && (
    <g transform="translate(90,40)">
      <rect width="440" height="200" fill="var(--court)" />
      <rect x="150" width="140" height="200" fill="var(--kitchen)" />
      <g stroke="var(--line)" stroke-width="3" fill="none">
        <rect width="440" height="200" /><line x1="150" x2="150" y2="200" /><line x1="290" x2="290" y2="200" />
        <line y1="100" x2="150" y2="100" /><line x1="290" y1="100" x2="440" y2="100" />
      </g>
      <line x1="220" y1="-14" x2="220" y2="214" stroke="var(--ink)" stroke-width="6" stroke-linecap="round" />
      <path d="M10 150 Q110 120 212 126" class="cv-trail" />
      <path d="M10 150 Q250 -60 486 22" class="cv-trail" />
      <path d="M10 150 Q200 40 372 150" class="cv-trail" />
      <g class="bounce"><circle cx="372" cy="150" r="9" /></g>
      <circle cx="10" cy="150" r="9" class="ball-dot" />
      <g transform="translate(220,126)" class="mk fault"><circle r="14" /><path d="M-6 -6 l12 12 M6 -6 l-12 12" fill="none" /></g>
      <g transform="translate(500,22)" class="mk fault"><circle r="14" /><path d="M-6 -6 l12 12 M6 -6 l-12 12" fill="none" /></g>
      <g transform="translate(372,122)" class="mk ok"><circle r="14" /><path d="M-7 0 l5 5 l9 -11" fill="none" /></g>
    </g>
  )}
  {kind === 'scoring' && (
    <g>
      <rect x="0" y="150" width="640" height="130" fill="var(--court)" />
      <line x1="0" y1="150" x2="640" y2="150" stroke="var(--line)" stroke-width="4" />
      <line x1="320" y1="150" x2="320" y2="280" stroke="var(--line)" stroke-width="4" />
      {['0', '0', '2'].map((n, i) => (
        <g transform={`translate(${170 + i * 150},92)`}>
          <rect x="-56" y="-62" width="112" height="124" rx="18" fill={i === 2 ? 'var(--ball)' : 'var(--ink)'} />
          <text y="30" text-anchor="middle" class="cv-num" fill={i === 2 ? 'var(--ball-ink)' : 'var(--paper)'}>{n}</text>
        </g>
      ))}
      <circle cx="560" cy="226" r="16" class="ball-dot" />
    </g>
  )}
  {kind === 'corner' && (
    <g>
      <rect x="80" y="60" width="560" height="220" fill="var(--court)" />
      <g stroke="var(--line)" stroke-width="5" fill="none"><line x1="80" y1="60" x2="640" y2="60" /><line x1="80" y1="60" x2="80" y2="280" /></g>
      <circle cx="320" cy="170" r="20" class="ball-dot" />
    </g>
  )}
</svg>

<style>
  .cv-step { font: 700 20px var(--display); }
</style>
