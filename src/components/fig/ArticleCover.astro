      <rect x="0" y="150" width="640" height="130" fill="var(--court)" />
      <line x1="0" y1="150" x2="640" y2="150" stroke="var(--line)" stroke-width="4" />
      <line x1="320" y1="150" x2="320" y2="280" stroke="var(--line)" stroke-width="4" />
      {['0', '0', '2'].map((n, i) => (
        <g transform={`translate(${170 + i * 150},92)`}>
          <rect x="-56" y="-62" width="112" height="124" rx="18" fill={i === 2 ? 'var(--ball)' : 'var(--ink)'} />
          <text y="30" text-anchor="middle" class="cv-num" fill={i === 2 ? 'var(--ball-ink)' : 'var(--paper)'}>{n}</text>
        </g>
      ))}
      <circle cx="560" cy="226" r="16" class="ball-dot" />
    </g>
  )}
  {kind === 'corner' && (
    <g>
      <rect x="80" y="60" width="560" height="220" fill="var(--court)" />
      <g stroke="var(--line)" stroke-width="5" fill="none"><line x1="80" y1="60" x2="640" y2="60" /><line x1="80" y1="60" x2="80" y2="280" /></g>
      <circle cx="320" cy="170" r="20" class="ball-dot" />
    </g>
  )}
</svg>

<style>
  .cv-step { font: 700 20px var(--display); }
</style>
