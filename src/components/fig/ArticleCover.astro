      <g transform="translate(400 40) rotate(10)"><rect width="56" height="70" rx="24" fill="var(--ball)" stroke="var(--ink)" stroke-width="5" /><rect x="21" y="66" width="14" height="34" rx="5" fill="var(--ink)" /></g>
