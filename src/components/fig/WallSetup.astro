---
// 側面示意：對牆練習。水平 1 公尺 = 110 單位（牆面在 x=70），垂直 1 公尺 = 110 單位，地面 y=230。
// 網高線 86.4 公分；目標框在線上方 15–30 公分；站位 2.1／2.7／3.7 公尺（My Pickleball Connect）。
import Figure from './Figure.astro';
const g = 230;
const wall = 70;
const m = 110;
const tape = g - 0.864 * m;
const spots = [
  { d: 2.1, text: '截擊 約 2.1 公尺', row: 0 },
  { d: 2.7, text: 'dink、reset 約 2.7 公尺', row: 1 },
  { d: 3.7, text: 'drop 約 3.7 公尺', row: 2 },
];
---
<Figure caption="側面示意圖。在牆上 86.4 公分高貼一條膠帶當球網，球打在線上面才算過網；線上方可以再貼一個目標框。練截擊站離牆約 2.1 公尺，dink 和 reset 約 2.7 公尺，drop 約 3.7 公尺。">
  <svg class="gear-fig ws" viewBox="0 0 560 350" role="img" aria-label="對牆練習側面示意圖：牆上 86.4 公分高貼網高線，練截擊站離牆約 2.1 公尺，dink 和 reset 約 2.7 公尺，drop 約 3.7 公尺">
    <rect x="30" y="20" width={wall - 30} height={g - 20} class="ws-wall" />
    <line x1="10" y1={g} x2="550" y2={g} stroke="var(--rule)" stroke-width="3" />
    <rect x={wall} y={g} width="480" height="8" fill="var(--court)" />
    <rect x={wall - 4} y={tape - 0.3 * m} width="8" height={0.15 * m} class="ws-target" />
    <line x1={wall - 40} y1={tape} x2={wall + 6} y2={tape} class="ws-tape" />
    <text class="lab dark big" x={wall + 16} y={tape + 6}>網高線 86.4 公分</text>
    <text class="lab dark" x={wall - 10} y={tape - 0.36 * m} text-anchor="end">目標框</text>
    <path d={`M${wall + 2.7 * m} ${g - 0.6 * m} Q${wall + 1.3 * m} ${tape - 1.1 * m} ${wall} ${tape - 0.22 * m}`} class="ws-arc" />
    <circle cx={wall} cy={tape - 0.22 * m} r="7" class="ball-dot" />
    {spots.map((s) => (
      <g>
        <circle cx={wall + s.d * m} cy={g - 8} r="8" class="ws-spot" />
        <line x1={wall} y1={g + 34 + s.row * 38} x2={wall + s.d * m} y2={g + 34 + s.row * 38} class="ws-dim" />
        <line x1={wall + s.d * m} y1={g} x2={wall + s.d * m} y2={g + 34 + s.row * 38} class="ws-tick" />
        <text class="lab dark" x={wall + 10} y={g + 28 + s.row * 38}>{s.text}</text>
      </g>
    ))}
  </svg>
</Figure>

<style>
  .ws-wall { fill: var(--muted); opacity: .25; }
  .ws-tape { stroke: var(--ball); stroke-width: 8; stroke-linecap: round; }
  .ws-target { fill: var(--kitchen); }
  .ws-arc { fill: none; stroke: var(--ink); stroke-width: 2.5; stroke-dasharray: 7 6; }
  .ws-spot { fill: var(--ink); }
  .ws-dim { stroke: var(--ink); stroke-width: 2; }
  .ws-tick { stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 4 4; }
</style>
