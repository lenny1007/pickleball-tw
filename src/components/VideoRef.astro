---
// 文章內的影片引用卡：YouTube 縮圖＋片名，點了直接跳到教練示範的時間點。
// 縮圖用 YouTube 官方縮圖網址（i.ytimg.com），不下載進 repo。
interface Props { id: string; t: string; title: string; note: string }
const { id, t, title, note } = Astro.props;
const sec = t.split(':').reduce((acc, n) => acc * 60 + Number(n), 0);
const url = `https://www.youtube.com/watch?v=${id}&t=${sec}s`;
---
<a class="vref" href={url} target="_blank" rel="nofollow noopener">
  <span class="thumb">
    <img src={`https://i.ytimg.com/vi/${id}/mqdefault.jpg`} alt="" width="320" height="180" loading="lazy" decoding="async" />
    <span class="ts">▶ {t}</span>
  </span>
  <span class="meta">
    <span class="note">{note}</span>
    <span class="title">{title}</span>
    <span class="ch">Better Pickleball・YouTube</span>
  </span>
</a>

<style>
  .vref { display: flex; gap: 16px; align-items: center; margin: 1.6em 0; padding: 12px; background: var(--card); border: 1px solid var(--rule); border-radius: 14px; text-decoration: none; color: inherit; }
  .vref:hover { border-color: var(--court); }
  .thumb { position: relative; flex: 0 0 200px; aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; background: var(--rule); }
  .thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ts { position: absolute; right: 6px; bottom: 6px; padding: 2px 8px; border-radius: 6px; background: rgba(0, 0, 0, .75); color: #fff; font-size: .8rem; font-variant-numeric: tabular-nums; }
  .meta { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .note { font-weight: 600; line-height: 1.5; }
  .title { font-size: .9rem; color: var(--muted); line-height: 1.45; }
  .ch { font-size: .8rem; color: var(--muted); }
  @media (max-width: 560px) {
    .vref { flex-direction: column; align-items: stretch; }
    .thumb { flex-basis: auto; }
  }
</style>
