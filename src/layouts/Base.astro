---
import '../styles/global.css';
import { CATEGORIES, SITE_NAME, SITE_DESCRIPTION, SITE_URL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** 額外的 JSON-LD 物件 */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description = SITE_DESCRIPTION, jsonLd = [], noindex = false } = Astro.props;
const fullTitle = title ? `${title}｜${SITE_NAME}` : `${SITE_NAME}｜匹克球規則、球拍與技術知識站`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  inLanguage: 'zh-Hant-TW',
};
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_TW" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Huninn&display=swap" />
    {[siteLd, ...jsonLd].map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body>
    <header class="site wrap">
      <a class="brand" href="/">
        <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="14" fill="var(--ball)"/><g fill="var(--ball-ink)" opacity=".55"><circle cx="16" cy="9" r="2"/><circle cx="10" cy="14" r="2"/><circle cx="22" cy="14" r="2"/><circle cx="12" cy="21" r="2"/><circle cx="20" cy="21" r="2"/><circle cx="16" cy="16" r="1.4"/></g></svg>
        {SITE_NAME}
      </a>
      <nav aria-label="主要分類">
        {CATEGORIES.filter((c) => c.slug !== 'technique').map((c) => <a href={`/articles/#${c.slug}`}>{c.name}</a>)}
        <a href="/knowledge/">技術卡</a>
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site wrap">
      <span>{SITE_NAME}・pickleball-tw.com</span>
      <span><a href="/about/">關於本站</a></span>
    </footer>
  </body>
</html>

<style>
  header.site { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-block: 18px; }
  .brand { display: flex; align-items: center; gap: 10px; font-family: var(--display); font-size: 1.25rem; text-decoration: none; }
  .brand svg { width: 30px; height: 30px; flex: none; }
  nav { display: flex; gap: 18px; flex-wrap: wrap; font-size: .95rem; }
  nav a { text-decoration: none; color: var(--muted); }
  nav a:hover { color: var(--ink); }
  footer.site {
    margin-top: 32px; padding-block: 40px 56px; border-top: 1px solid var(--rule);
    color: var(--muted); font-size: .9rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px;
  }
  @media (max-width: 560px) { nav { width: 100%; gap: 14px; } }
</style>
