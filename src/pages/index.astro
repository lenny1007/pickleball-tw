---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CourtMap from '../components/CourtMap.astro';
import KnowledgeCard from '../components/KnowledgeCard.astro';

const cards = (await getCollection('knowledge')).slice(0, 3);
const tries = ['雙彈跳', '計分', '碳纖維球拍', 'dink 小球'];
---
<Base>
  <section class="hero">
    <div class="hero-text">
      <h1>第一次打匹克球，<br />不知道的事都在球場上找得到</h1>
      <p class="lede">規則、球拍怎麼挑、網前小球怎麼打。把國內外教學影片整理成一張張看得懂的中文卡片，每張都附原片時間點。</p>
      <form class="search" role="search" action="/knowledge/" method="get">
        <label for="q" class="sr-only">搜尋匹克球問題</label>
        <input id="q" name="q" type="search" placeholder="例如：非截擊區可以踩線嗎" />
        <button type="submit">搜尋</button>
      </form>
      <p class="tries">
        <span>大家在找：</span>
        {tries.map((t) => <a href={`/knowledge/?q=${encodeURIComponent(t)}`}>{t}</a>)}
      </p>
    </div>
    <CourtMap />
  </section>

  <section class="block" id="rules">
    <h2>新手最常卡住的規則</h2>
    <p class="sub">第一次上場前看完這幾條，跟陌生球友打臨打就不會一直被糾正。</p>
    <ul class="qa">
      <li><h3>非截擊區（廚房區）是什麼？</h3><p>網子兩側各 <span class="n">2.13 公尺</span>（7 呎）的區域。站在裡面不能截擊，也就是球沒落地前不能打。</p></li>
      <li><h3>雙彈跳規則</h3><p>發球後，接發方要等球彈地一次再打，發球方回擊時也要等彈地一次。之後才可以截擊。</p></li>
      <li><h3>發球一定要低手嗎？</h3><p>一般發球要低手、擊球點在腰部以下，往對角發。另有「落地發球」，可以先讓球落地再打。</p></li>
      <li><h3>分數怎麼算？</h3><p>一般打到 <span class="n">11</span> 分、領先 2 分獲勝；傳統計分只有發球方能得分，雙打報分會報三個數字。</p></li>
    </ul>
  </section>

  <section class="block" id="paddles">
    <h2>球拍怎麼挑</h2>
    <p class="sub">先搞懂這三個取捨，再看型號。</p>
    <div class="specs">
      <div class="spec"><div class="k">拍面材質</div><div class="side"><b>玻璃纖維</b><span>彈性大、好把球送深，入門價位常見</span></div><div class="side"><b>碳纖維</b><span>控球穩、手感扎實，價格較高</span></div></div>
      <div class="spec"><div class="k">拍面厚度</div><div class="side"><b>厚（約 16 mm）</b><span>甜區大、小球好控制</span></div><div class="side"><b>薄（約 13 mm）</b><span>出球快、力量傳得直接</span></div></div>
      <div class="spec"><div class="k">重量</div><div class="side"><b>輕</b><span>網前反應快、手腕負擔小</span></div><div class="side"><b>重</b><span>穩定、底線抽球有份量</span></div></div>
    </div>
  </section>

  <section class="block" id="cards">
    <h2>從教學影片整理的技術卡</h2>
    <p class="sub">每張卡只講一件事：做什麼、為什麼、怎麼練，附原片時間點，點下去直接看那一段。</p>
    {cards.length > 0 ? (
      <div class="cards">{cards.map((c) => <KnowledgeCard card={c.data} />)}</div>
    ) : (
      <p class="empty">第一批技術卡整理中。想先看什麼技術，可以從上面的搜尋框告訴我們你在找什麼。</p>
    )}
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 420px); gap: 48px; align-items: center; padding-block: 28px 56px; }
  .hero h1 { font-size: clamp(2.1rem, 5.4vw, 3.6rem); line-height: 1.18; margin: 0 0 18px; }
  .lede { font-size: 1.1rem; color: var(--muted); max-width: 30em; margin: 0 0 28px; }
  .search { display: flex; gap: 8px; max-width: 520px; }
  .search input { flex: 1; min-width: 0; font: inherit; padding: 12px 16px; border: 2px solid var(--ink); border-radius: 999px; background: var(--card); color: var(--ink); }
  .search button { font: inherit; font-weight: 600; padding: 12px 20px; border: 0; border-radius: 999px; background: var(--ink); color: var(--paper); cursor: pointer; }
  .tries { margin: 14px 0 0; font-size: .92rem; color: var(--muted); display: flex; flex-wrap: wrap; gap: 8px 14px; }
  .tries a { color: var(--ink); text-decoration-color: var(--rule); text-underline-offset: 4px; }

  .block { padding-block: 48px; border-top: 1px solid var(--rule); }
  .block h2 { font-size: 1.75rem; line-height: 1.3; margin: 0 0 6px; }
  .sub { color: var(--muted); margin: 0 0 28px; max-width: var(--measure); }
  .empty { color: var(--muted); }

  .qa { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 48px; margin: 0; padding: 0; list-style: none; }
  .qa li { padding-block: 16px; border-bottom: 1px dashed var(--rule); min-width: 0; }
  .qa h3 { font-size: 1.05rem; margin: 0 0 4px; font-weight: 600; }
  .qa p { margin: 0; color: var(--muted); }
  .qa .n { font-variant-numeric: tabular-nums; color: var(--ink); font-weight: 600; }

  .specs { border: 2px solid var(--ink); border-radius: 14px; overflow: hidden; background: var(--card); }
  .spec { display: grid; grid-template-columns: 9em minmax(0, 1fr) minmax(0, 1fr); gap: 16px; padding: 18px 20px; border-top: 1px solid var(--rule); }
  .spec:first-child { border-top: 0; }
  .spec .k { font-family: var(--display); font-size: 1.1rem; }
  .spec .side { min-width: 0; }
  .spec b { display: block; font-weight: 600; }
  .spec span { color: var(--muted); font-size: .93rem; }

  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .qa, .cards, .spec { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 520px) { .search { flex-direction: column; } }
</style>
