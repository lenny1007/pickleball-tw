---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORIES, SITE_NAME, SITE_URL } from '../../consts';
import ArticleCover from '../../components/fig/ArticleCover.astro';
import ArticleRail from '../../components/ArticleRail.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { breadcrumbLd } from '../../lib/breadcrumb';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a, all: articles } }));
}
interface Props { article: CollectionEntry<'articles'>; all: CollectionEntry<'articles'>[] }
const { article, all } = Astro.props;
const { Content, headings } = await render(article);
const d = article.data;
const category = CATEGORIES.find((c) => c.slug === d.category)!;
const fmt = (date: Date) => date.toISOString().slice(0, 10);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: fmt(d.pubDate),
  dateModified: fmt(d.updatedDate ?? d.pubDate),
  inLanguage: 'zh-Hant-TW',
  mainEntityOfPage: new URL(`/articles/${article.id}/`, SITE_URL).href,
  publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
};
const crumbs = [
  { name: '首頁', url: '/' },
  { name: category.name, url: `/topics/${category.slug}/` },
  { name: d.title, url: `/articles/${article.id}/` },
];
---
<Base title={d.title} description={d.description} jsonLd={[ld, breadcrumbLd(crumbs)]}>
  <article class="prose">
    <Breadcrumb items={crumbs} />
    <h1>{d.title}</h1>
    <p class="date">
      {d.updatedDate ? <>更新於 <time datetime={fmt(d.updatedDate)}>{fmt(d.updatedDate)}</time></> : <time datetime={fmt(d.pubDate)}>{fmt(d.pubDate)}</time>}
    </p>
    {d.cover ? (
      <figure class="cover">
        <Image src={d.cover} alt={d.cover_alt ?? ''} widths={[480, 760, 1140]} sizes="(max-width: 640px) 100vw, 38em" loading="eager" fetchpriority="high" />
        <figcaption>示意圖（AI 生成）</figcaption>
      </figure>
    ) : (
      <div class="cover-wrap"><ArticleCover slug={article.id} /></div>
    )}
    {d.takeaways && (
      <aside class="takeaways" aria-label="重點">
        <p class="tk-head">重點整理</p>
        <ul>{d.takeaways.map((t) => <li>{t}</li>)}</ul>
      </aside>
    )}
    <ArticleToc headings={headings} />
    <Content />
  </article>
  <RelatedArticles current={article} all={all} />
  <ArticleRail headings={headings} />
</Base>

<style>
  .date { font-size: .9rem; color: var(--muted); margin: 0; }
  .prose h1 { font-size: clamp(1.8rem, 4.2vw, 2.6rem); line-height: 1.28; margin: .3em 0 .3em; }
  .cover-wrap { margin: 20px 0 4px; }
  .cover { margin: 20px 0 4px; }
  .cover img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 12px; }
  .cover figcaption { font-size: .8rem; color: var(--muted); margin-top: 6px; }
  .takeaways { margin: 24px 0 8px; padding: 16px 20px; border-left: 6px solid var(--ball); background: var(--card); border-radius: 0 12px 12px 0; }
  .tk-head { margin: 0 0 6px; font-weight: 700; }
  .takeaways ul { margin: 0; padding-left: 1.2em; }
</style>
