---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { ZONES, type ZoneKey } from '../../consts';

export async function getStaticPaths() {
  const cards = await getCollection('knowledge');
  return cards.map((c) => ({ params: { id: c.data.id }, props: { card: c.data } }));
}
interface Props { card: CollectionEntry<'knowledge'>['data'] }
const { card } = Astro.props;
const zone = ZONES[card.zone as ZoneKey];
const toSeconds = (t: string) => t.split(':').reduce((acc, n) => acc * 60 + Number(n), 0);
const videoUrl = `https://www.youtube.com/watch?v=${card.source_video_id}&t=${toSeconds(card.timestamp)}s`;
---
<Base title={card.title} description={card.what} noindex={!card.index}>
  <article class="prose">
    <p class="crumb"><a href="/knowledge/">技術卡</a> ／ <a href={`/knowledge/#${card.zone}`}>{zone.name}</a></p>
    <h1>{card.title}</h1>
    <p class="what">{card.what}</p>
    {card.why && (<><h2>為什麼</h2><p>{card.why}</p></>)}
    {card.how.length > 0 && (<><h2>怎麼練</h2><ol>{card.how.map((s) => <li>{s}</li>)}</ol></>)}
    {card.check && (<><h2>怎麼知道做對了</h2><p>{card.check}</p></>)}
    <p class="source">來源：<a href={videoUrl} rel="nofollow noopener" target="_blank">{card.source_channel}〈{card.source_title}〉{card.timestamp}</a></p>
  </article>
</Base>

<style>
  .crumb { font-size: .9rem; color: var(--muted); margin: 0; }
  .prose h1 { font-size: clamp(1.7rem, 4vw, 2.4rem); line-height: 1.3; margin: .3em 0 .5em; }
  .what { font-size: 1.1rem; }
  .source { margin-top: 2.5em; padding-top: 12px; border-top: 1px dashed var(--rule); color: var(--muted); font-size: .92rem; }
</style>
